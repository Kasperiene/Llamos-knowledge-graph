{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:llamos-kg:annotation:v2.1",
  "title": "Identity Leadership Paper Annotation Schema v2.1",
  "description": "Ground-truth annotation schema for LLM extraction evaluation. An annotation is not a ground truth until review_status='verified'.",

  "definitions": {

    "Status": {
      "type": "string",
      "enum": ["pending", "reported", "not_reported", "not_applicable", "ambiguous"],
      "description": "pending=not yet checked; reported=explicitly stated in paper (quote required); not_reported=annotator checked, not in paper; not_applicable=irrelevant to this paper type; ambiguous=present but unclear or contradictory (quote required)"
    },

    "Claim": {
      "type": "object",
      "description": "An extractable fact. status=reported and status=ambiguous require a non-empty quote.",
      "required": ["value", "status"],
      "additionalProperties": false,
      "properties": {
        "value":       { "description": "Extracted value. null only with status pending/not_reported/not_applicable." },
        "status":      { "$ref": "#/definitions/Status" },
        "quote":       { "type": ["string", "null"], "description": "Verbatim source text. Required when status=reported or ambiguous." },
        "page":        { "type": ["integer", "null"], "minimum": 1, "description": "PDF page number if reliably determined; null otherwise." },
        "section":     { "type": ["string", "null"], "description": "Section heading (localisation only, not a substitute for quote)." },
        "fragment_id": { "type": ["string", "null"], "description": "Parser fragment or block ID if available." }
      }
    },

    "AnnotationProvenance": {
      "type": "object",
      "required": ["origin", "review_status", "created_by", "created_date"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "enum": ["human", "model", "human_revised", "final_reconciled", "unknown"],
          "description": "human=written by human; model=LLM-generated, unreviewed; human_revised=model draft corrected by human; final_reconciled=inter-rater agreed; unknown=provenance not recorded."
        },
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "reviewed", "verified"],
          "description": "unreviewed=no human checked; reviewed=human read+edited; verified=confirmed against PDF by qualified annotator."
        },
        "created_by":   { "type": "string" },
        "created_date": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "model_id":     { "type": ["string", "null"] },
        "reviewed_by":  { "type": ["string", "null"] },
        "reviewed_date":{ "type": ["string", "null"], "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "human_read_time_minutes":  { "type": ["number", "null"], "description": "Time spent reading the PDF." },
        "model_run_time_seconds":   { "type": ["number", "null"], "description": "Model inference wall-clock time only." },
        "correction_time_minutes":  { "type": ["number", "null"], "description": "Time correcting a model draft." },
        "legacy_time_minutes":      { "type": ["number", "null"], "description": "Time value from pre-v2.1 annotation; purpose unknown — do not use as model or human time." }
      }
    },

    "TheoreticalRef": {
      "type": "object",
      "required": ["name", "status"],
      "additionalProperties": false,
      "properties": {
        "name":    { "type": "string", "description": "Named theory, model, or framework." },
        "status":  { "$ref": "#/definitions/Status" },
        "quote":   { "type": ["string", "null"] },
        "page":    { "type": ["integer", "null"], "minimum": 1 },
        "section": { "type": ["string", "null"] }
      }
    },

    "KeyFinding": {
      "type": "object",
      "required": ["statement", "status"],
      "additionalProperties": false,
      "properties": {
        "statement":    { "type": "string", "description": "One sentence. From this paper's results only." },
        "status":       { "$ref": "#/definitions/Status" },
        "finding_type": {
          "type": ["string", "null"],
          "enum": ["main_result", "methodological", "theoretical", "practical", "limitation", "future_direction", null]
        },
        "quote":   { "type": ["string", "null"], "description": "Required when status=reported." },
        "page":    { "type": ["integer", "null"], "minimum": 1 },
        "section": { "type": ["string", "null"] }
      }
    },

    "Construct": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name":             { "$ref": "#/definitions/Claim" },
        "role": {
          "type": "string",
          "enum": ["independent", "dependent", "mediator", "moderator", "predictor", "outcome", "focal", "control", "psychometric_target", "not_applicable"]
        },
        "measure_name":       { "$ref": "#/definitions/Claim" },
        "items_n":            { "$ref": "#/definitions/Claim" },
        "reliability":        { "$ref": "#/definitions/Claim" },
        "reliability_type":   { "type": ["string", "null"], "enum": ["alpha", "omega", "omega_h", "composite", "test_retest", "other", null] },
        "psychometric_notes": { "type": ["string", "null"] }
      }
    },

    "Hypothesis": {
      "type": "object",
      "required": ["id", "statement"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "statement":   { "$ref": "#/definitions/Claim" },
        "result":      { "$ref": "#/definitions/Claim" },
        "effect_size": { "$ref": "#/definitions/Claim" },
        "item_type": {
          "type": ["string", "null"],
          "enum": ["hypothesis", "research_question", "proposition", "exploratory", "post_hoc", null]
        }
      }
    },

    "Study": {
      "type": "object",
      "required": ["study_id"],
      "additionalProperties": false,
      "properties": {
        "study_id": { "type": "string" },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "methodology":     { "$ref": "#/definitions/Claim" },
            "study_type":      { "$ref": "#/definitions/Claim" },
            "data_collection": { "$ref": "#/definitions/Claim" },
            "country":         { "$ref": "#/definitions/Claim" }
          }
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total_n":               { "$ref": "#/definitions/Claim" },
            "population":            { "$ref": "#/definitions/Claim" },
            "age_mean":              { "$ref": "#/definitions/Claim" },
            "age_range":             { "$ref": "#/definitions/Claim" },
            "gender_percent_female": { "$ref": "#/definitions/Claim" }
          }
        },
        "constructs":    { "type": "array", "items": { "$ref": "#/definitions/Construct" } },
        "hypotheses":    { "type": "array", "items": { "$ref": "#/definitions/Hypothesis" } },
        "results_notes": { "type": ["string", "null"] }
      }
    }

  },

  "type": "object",
  "required": ["paper_id", "schema_version", "annotation_provenance", "metadata"],
  "additionalProperties": false,

  "properties": {
    "paper_id":       { "type": "string", "description": "Normalized filename stem (no smart quotes, max 80 chars)." },
    "schema_version": { "type": "string", "const": "2.1" },

    "annotation_provenance": { "$ref": "#/definitions/AnnotationProvenance" },

    "metadata": {
      "type": "object",
      "required": ["title", "authors", "year", "journal", "doi", "paper_type_profile", "publication_version"],
      "additionalProperties": false,
      "properties": {
        "title":   { "$ref": "#/definitions/Claim" },
        "authors": { "$ref": "#/definitions/Claim" },
        "year":    { "$ref": "#/definitions/Claim" },
        "journal": { "$ref": "#/definitions/Claim" },
        "doi":     { "$ref": "#/definitions/Claim" },
        "paper_type_profile": {
          "type": "string",
          "enum": ["quantitative_empirical", "qualitative_empirical", "mixed_methods", "scale_validation", "theoretical", "review", "other"]
        },
        "publication_version": {
          "type": "string",
          "enum": ["published", "preprint", "postprint", "accepted_manuscript", "unknown"]
        }
      }
    },

    "studies":              { "type": "array", "items": { "$ref": "#/definitions/Study" } },
    "key_findings":         { "type": "array", "items": { "$ref": "#/definitions/KeyFinding" } },
    "theoretical_framework":{ "type": "array", "items": { "$ref": "#/definitions/TheoreticalRef" } },
    "notes":                { "type": "string" }
  }
}
