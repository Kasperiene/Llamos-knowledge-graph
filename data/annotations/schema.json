{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:llamos-kg:annotation:v2.0",
  "title": "Identity Leadership Paper Annotation Schema v2.0",
  "description": "Formal schema for human-prepared ground-truth annotations used in LLM extraction evaluation. A completed annotation is NOT a ground truth until review_status is 'verified'.",

  "definitions": {

    "Status": {
      "type": "string",
      "enum": ["pending", "reported", "not_reported", "not_applicable", "ambiguous"],
      "description": "pending=not yet checked; reported=explicitly stated in paper; not_reported=annotator checked, paper does not state; not_applicable=irrelevant to this paper type; ambiguous=present but unclear or contradictory"
    },

    "Claim": {
      "type": "object",
      "description": "A single extractable fact with provenance. If status=reported, at least one of quote/page/section must be non-null.",
      "required": ["value", "status"],
      "additionalProperties": false,
      "properties": {
        "value":       { "description": "The extracted value. null is allowed only with status not_reported/not_applicable/pending." },
        "status":      { "$ref": "#/definitions/Status" },
        "quote":       { "type": ["string", "null"], "description": "Verbatim text from the paper supporting this claim." },
        "page":        { "type": ["integer", "null"], "description": "PDF page number if reliably determinable; null otherwise." },
        "section":     { "type": ["string", "null"], "description": "Section heading (e.g. 'Method', 'Participants')." },
        "fragment_id": { "type": ["string", "null"], "description": "Parser fragment or block ID if available." }
      }
    },

    "AnnotationProvenance": {
      "type": "object",
      "required": ["origin", "review_status", "created_by", "created_date"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "enum": ["human", "model", "human_revised", "final_reconciled"],
          "description": "human=written by a human; model=generated by an LLM without human review; human_revised=model draft corrected by human; final_reconciled=agreed version after inter-rater check."
        },
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "reviewed", "verified"],
          "description": "unreviewed=no human has checked this yet; reviewed=a human has read and edited; verified=confirmed against PDF by a qualified annotator."
        },
        "created_by":  { "type": "string", "description": "Name or model ID of creator." },
        "created_date":{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "model_id":    { "type": ["string", "null"], "description": "Model identifier if origin=model or human_revised." },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_date":{ "type": ["string", "null"], "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "human_read_time_minutes": { "type": ["number", "null"], "description": "Time a human spent reading the PDF for this annotation." },
        "model_run_time_seconds":  { "type": ["number", "null"], "description": "Wall-clock time for model inference, if applicable." },
        "correction_time_minutes": { "type": ["number", "null"], "description": "Time a human spent correcting a model draft." }
      }
    },

    "Construct": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name":              { "$ref": "#/definitions/Claim", "description": "Construct name as used in the paper." },
        "role": {
          "type": "string",
          "enum": ["independent", "dependent", "mediator", "moderator", "predictor", "outcome", "focal", "control", "psychometric_target", "not_applicable"],
          "description": "Role in the study design. Use focal for qualitative/theoretical constructs with no strict IV/DV distinction."
        },
        "measure_name":        { "$ref": "#/definitions/Claim", "description": "Name of scale or instrument." },
        "items_n":             { "$ref": "#/definitions/Claim", "description": "Number of items." },
        "reliability":         { "$ref": "#/definitions/Claim", "description": "Reliability coefficient (numeric)." },
        "reliability_type":    { "type": ["string", "null"], "enum": ["alpha", "omega", "omega_h", "composite", "test_retest", "other", null] },
        "psychometric_notes":  { "type": ["string", "null"], "description": "CFA fit, factor loadings, AVE, etc. for scale validation papers." }
      }
    },

    "Hypothesis": {
      "type": "object",
      "required": ["id", "statement"],
      "additionalProperties": false,
      "properties": {
        "id":           { "type": "string", "description": "e.g. H1, RQ2, Proposition 3" },
        "statement":    { "$ref": "#/definitions/Claim", "description": "Hypothesis as stated or closely paraphrased." },
        "result":       { "$ref": "#/definitions/Claim", "description": "Outcome: supported/not supported/partial/not tested." },
        "effect_size":  { "$ref": "#/definitions/Claim", "description": "e.g. beta=.34, r=.51, d=0.62." },
        "item_type": {
          "type": "string",
          "enum": ["hypothesis", "research_question", "proposition", "exploratory", "post_hoc"],
          "description": "Distinguish formal hypothesis from exploratory or post-hoc analysis."
        }
      }
    },

    "Study": {
      "type": "object",
      "required": ["study_id"],
      "additionalProperties": false,
      "properties": {
        "study_id": { "type": "string", "description": "e.g. Study 1, Study 2, or 'single'" },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "methodology":     { "$ref": "#/definitions/Claim", "description": "quantitative/qualitative/mixed/experimental/descriptive" },
            "study_type":      { "$ref": "#/definitions/Claim", "description": "cross-sectional/longitudinal/RCT/IPA/grounded_theory/survey/scale_validation/other" },
            "data_collection": { "$ref": "#/definitions/Claim", "description": "survey/interview/observation/archival/experiment/other" },
            "country":         { "$ref": "#/definitions/Claim" }
          }
        },
        "sample": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total_n":               { "$ref": "#/definitions/Claim" },
            "population":            { "$ref": "#/definitions/Claim" },
            "age_mean":              { "$ref": "#/definitions/Claim" },
            "age_range":             { "$ref": "#/definitions/Claim" },
            "gender_percent_female": { "$ref": "#/definitions/Claim" }
          }
        },
        "constructs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Construct" }
        },
        "hypotheses": {
          "type": "array",
          "items": { "$ref": "#/definitions/Hypothesis" }
        },
        "results_notes": {
          "type": ["string", "null"],
          "description": "Free-text summary of main quantitative/qualitative results for this study."
        }
      }
    },

    "KeyFinding": {
      "type": "object",
      "required": ["statement"],
      "additionalProperties": false,
      "properties": {
        "statement":    { "type": "string", "description": "One sentence. Must be from the current paper's results, not prior literature." },
        "finding_type": {
          "type": "string",
          "enum": ["main_result", "methodological", "theoretical", "practical", "limitation", "future_direction"]
        },
        "quote":    { "type": ["string", "null"] },
        "page":     { "type": ["integer", "null"] },
        "section":  { "type": ["string", "null"] }
      }
    }
  },

  "type": "object",
  "required": ["paper_id", "schema_version", "annotation_provenance", "metadata"],
  "additionalProperties": false,

  "properties": {

    "paper_id":      { "type": "string", "description": "Filename stem (without .pdf), max 80 chars." },
    "schema_version":{ "type": "string", "const": "2.0" },

    "annotation_provenance": { "$ref": "#/definitions/AnnotationProvenance" },

    "metadata": {
      "type": "object",
      "required": ["title", "authors", "year", "journal", "doi", "paper_type_profile", "publication_version"],
      "additionalProperties": false,
      "properties": {
        "title":       { "$ref": "#/definitions/Claim" },
        "authors":     { "$ref": "#/definitions/Claim", "description": "value should be an array of 'Last, First' strings." },
        "year":        { "$ref": "#/definitions/Claim", "description": "value is integer publication year." },
        "journal":     { "$ref": "#/definitions/Claim" },
        "doi":         { "$ref": "#/definitions/Claim" },
        "paper_type_profile": {
          "type": "string",
          "enum": ["quantitative_empirical", "qualitative_empirical", "mixed_methods", "scale_validation", "theoretical", "review", "other"],
          "description": "Overall paper type. Drives which studies[] fields are required."
        },
        "publication_version": {
          "type": "string",
          "enum": ["published", "preprint", "postprint", "accepted_manuscript", "unknown"],
          "description": "Important for reproducibility — postprints/preprints may differ from published version."
        }
      }
    },

    "studies": {
      "type": "array",
      "description": "One entry per study. Single-study papers have one element with study_id='single'.",
      "items": { "$ref": "#/definitions/Study" }
    },

    "key_findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/KeyFinding" },
      "description": "3–6 findings from this paper's own results. Do NOT include claims from prior literature."
    },

    "theoretical_framework": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Named theories or models this paper explicitly draws on."
    },

    "notes": {
      "type": "string",
      "description": "Anything ambiguous, unusual, or worth flagging for LLM comparison."
    }
  }
}
